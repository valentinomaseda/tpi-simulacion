		<!--   =========  Parameter Variation Experiment   ========  -->
		<ParamVariationExperiment ActiveObjectClassId="1791236712587">
			<Id>1791253797971</Id>
			<Name><![CDATA[ParametersVariation]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<MaximumMemory>512</MaximumMemory>
			<RandomNumberGenerationType>randomSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<AfterSimulationRunCode><![CDATA[// 1. W: Tiempo promedio en el sistema (convertido de segundos a minutos)
double wTotal = root.timeMeasureEnd.distribution.mean() / 60.0;

// 2. Lq: Longitud de cola (Sumamos la gente esperando en las 27 filas y dividimos por las 9 mesas)
double lqTotal = root.queue.statsSize.mean() + root.queue1.statsSize.mean() + root.queue2.statsSize.mean() + root.queue3.statsSize.mean() + root.queue4.statsSize.mean() + root.queue5.statsSize.mean() + root.queue6.statsSize.mean() + root.queue7.statsSize.mean() + root.queue8.statsSize.mean() + root.queue9.statsSize.mean() + root.queue10.statsSize.mean() + root.queue11.statsSize.mean() + root.queue12.statsSize.mean() + root.queue13.statsSize.mean() + root.queue14.statsSize.mean() + root.queue15.statsSize.mean() + root.queue16.statsSize.mean() + root.queue17.statsSize.mean() + root.queue18.statsSize.mean() + root.queue19.statsSize.mean() + root.queue20.statsSize.mean() + root.queue21.statsSize.mean() + root.queue22.statsSize.mean() + root.queue23.statsSize.mean() + root.queue24.statsSize.mean() + root.queue25.statsSize.mean() + root.queue26.statsSize.mean();
double lqPromedioMesa = lqTotal / 9.0;

// 3. U: Utilización promedio de los 9 biombos (en formato porcentaje)
double usoBiombos = (root.biomboMesa1.statsUtilization.mean() + root.biomboMesa2.statsUtilization.mean() + root.biomboMesa3.statsUtilization.mean() + root.biomboMesa4.statsUtilization.mean() + root.biomboMesa5.statsUtilization.mean() + root.biomboMesa6.statsUtilization.mean() + root.biomboMesa7.statsUtilization.mean() + root.biomboMesa8.statsUtilization.mean() + root.biomboMesa9.statsUtilization.mean()) / 9.0 * 100.0;

// 4. Imprimir los resultados listos para Excel
traceln("W (min): " + wTotal + " | Lq (Prom/Mesa): " + lqPromedioMesa + " | Uso Biombos (%): " + usoBiombos);]]></AfterSimulationRunCode>
			<SeedValue>1</SeedValue>
			<SelectionModeForSimultaneousEvents>LIFO</SelectionModeForSimultaneousEvents>
