		<!--   =========  Parameter Variation Experiment   ========  -->
		<ParamVariationExperiment ActiveObjectClassId="1791236712587">
			<Id>1791405426633</Id>
			<Name><![CDATA[ParametersVariation2]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<MaximumMemory>512</MaximumMemory>
			<RandomNumberGenerationType>randomSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<AfterSimulationRunCode><![CDATA[traceln("--- RESULTADOS DE LA RÉPLICA (EXTRAPOLADO A 10 HS REALES) ---");

// W total: (segundos simulados * 2) / 60 = minutos reales
double wTotal = (root.timeMeasureEnd.distribution.mean() * 2.0) / 60.0;

// Como en el Paso 4 ya multiplicamos por 2.0 al guardar en los HistogramData, aquí solo dividimos por 60
double tAcreditacion = root.statsAcreditacion.mean() / 60.0;
double tBiombo = root.statsBiombo.mean() / 60.0;
double tEgreso = root.statsEgreso.mean() / 60.0;

traceln("W Total (min): " + wTotal + " | Acreditación (min): " + tAcreditacion + " | Biombo (min): " + tBiombo + " | Egreso (min): " + tEgreso);]]></AfterSimulationRunCode>
			<SeedValue>1</SeedValue>
			<SelectionModeForSimultaneousEvents>LIFO</SelectionModeForSimultaneousEvents>
			<VmArgs><![CDATA[]]></VmArgs>
			<LoadRootFromSnapshot>false</LoadRootFromSnapshot>


			<AllowParallelEvaluations>true</AllowParallelEvaluations>
			<UseFreeformParameters>false</UseFreeformParameters>
			<NumberOfRuns>10</NumberOfRuns>
			<ModelTimeProperties>
				<StopOption><![CDATA[Stop at specified time]]></StopOption>
				<InitialDate><![CDATA[1791158400000]]></InitialDate>	
				<InitialTime><![CDATA[0.0]]></InitialTime>	
				<FinalDate><![CDATA[1791176400000]]></FinalDate>	
				<FinalTime><![CDATA[18000.0]]></FinalTime>	
			</ModelTimeProperties>
			<PresentationProperties>
				<EnableZoomAndPanning>true</EnableZoomAndPanning>
				<Title><![CDATA[flujo_votantes_1b : ParametersVariation]]></Title>
				<EnableDeveloperPanel>true</EnableDeveloperPanel>
